# Frontend host and local Vite proxy environment
VITE_CONVEX_URL=
# Server-only Convex HTTP target for the Vercel auth function.
CONVEX_SITE_URL=
# Local Vite proxy target, normally generated by `convex dev`.
VITE_CONVEX_SITE_URL=
# Optional override for the local /api/auth proxy.
AUTH_PROXY_TARGET=

# Convex backend environment. Set these with `bun x convex env set`; do not
# expose their values to Vite with a VITE_ prefix.
SITE_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=Code Trainer <auth@example.com>
