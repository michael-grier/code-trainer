{
  "name": "code-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run build:runner && vite",
    "dev:vite": "bun run build:runner && vite --host 127.0.0.1 --port 5173",
    "dev:convex": "convex dev --typecheck disable",
    "dev:all": "bash ./scripts/dev-all.sh",
    "build": "bun run build:runner && tsc -b && vite build",
    "build:runner": "node scripts/build-runner-sandbox.mjs",
    "lint": "eslint .",
    "test": "vitest run --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.0.0",
    "@convex-dev/better-auth": "0.12.5",
    "@fontsource-variable/geist": "^5.0.0",
    "@mdx-js/rollup": "^3.0.0",
    "@monaco-editor/react": "^4.0.0",
    "@radix-ui/react-checkbox": "^1.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-dropdown-menu": "^2.0.0",
    "@radix-ui/react-popover": "^1.0.0",
    "@radix-ui/react-progress": "^1.0.0",
    "@radix-ui/react-scroll-area": "^1.0.0",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@radix-ui/react-tabs": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "better-auth": "1.6.30",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "convex": "1.45.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sonner": "^2.0.0",
    "sucrase": "^3.0.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^15.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
